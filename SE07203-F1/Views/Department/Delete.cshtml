@{
}
@model SE07203_F1.Models.Department

@{
    ViewData["Title"] = "Xác nhận Xóa";
}

<h1>Xác nhận Xóa Khoa</h1>

<h3>Bạn có chắc chắn muốn xóa khoa này không?</h3>
<div>
    <h4>@Model.Name</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Tên Khoa:</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Name)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
    </form>
</div>