@{
}
@model IEnumerable<SE07203_F1.Models.Course>
<h1>Courses</h1>

<a href="@Url.Action("Create")" class="btn btn-primary mb-2">Add New Course</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var course in Model)
        {
            <tr>
                <td>@course.Code</td>
                <td>@course.Name</td>
            </tr>
        }
    </tbody>
</table>
