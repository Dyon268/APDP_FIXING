@{
}
@model IEnumerable<SE07203_F1.Models.Lecturer>
<h1>Lecturers</h1>

<a href="@Url.Action("Create")" class="btn btn-primary mb-2">Add New Lecturer</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Fullname</th>
            <th>Account</th>
            <th>Department</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var lecturer in Model)
        {
            <tr>
                <td>@lecturer.Fullname</td>
                <td>@lecturer.Account?.Username</td>
                <td>@lecturer.Department?.Name</td>
            </tr>
        }
    </tbody>
</table>
