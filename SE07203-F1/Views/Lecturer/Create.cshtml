@{
}
@model SE07203_F1.Models.Lecturer

<h1>Create Lecturer</h1>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Fullname" class="form-label"></label>
        <input asp-for="Fullname" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Account</label>
        <select asp-for="AccountId" class="form-select">
            @foreach (var acc in ViewBag.Accounts)
            {
                <option value="@acc.Id">@acc.Username</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label>Department</label>
        <select asp-for="DepartmentId" class="form-select">
            @foreach (var dept in ViewBag.Departments)
            {
                <option value="@dept.Id">@dept.Name</option>
            }
        </select>
    </div>

    <button class="btn btn-success">Submit</button>
</form>
