@model SE07203_F1.Models.Account
@{
    ViewData["Title"] = "Dashboard";
    string role = ViewBag.role?.ToString() ?? "Guest";
    bool isLogin = ViewBag.isLogin ?? false;
}

<div class="container-fluid">
    <div class="row">

        <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse p-3">
            <div class="text-center mb-4 text-white border-bottom pb-3">
                <i class="bi bi-mortarboard-fill fs-2"></i>
                <h4 class="mt-2">SIMS Portal</h4>
            </div>

            @if (isLogin)
            {
                <div class="text-center mb-4">
                    <img src="https://ui-avatars.com/api/?name=@Model.Fullname&background=random" class="rounded-circle mb-2" width="60" alt="Avatar">
                    <h6 class="text-white mb-0">@Model.Fullname</h6>
                    <small class="text-muted text-uppercase" style="font-size: 0.75rem;">@role</small>
                </div>
            }

            <div class="d-flex flex-column justify-content-between" style="height: calc(100vh - 200px);">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link active" href="@Url.Action("Index", "Home")">
                            <i class="bi bi-speedometer2 me-2"></i> Dashboard
                        </a>
                    </li>

                    @if (isLogin)
                    {
                        @if (role == "Admin")
                        {
                            <li class="nav-item mt-3 text-uppercase text-muted small fw-bold">Management</li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Index", "Admin")">
                                    <i class="bi bi-people-fill me-2"></i> Quản lý User
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Index", "Course")">
                                    <i class="bi bi-book-half me-2"></i> Quản lý Môn học
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Index", "Enrollment")">
                                    <i class="bi bi-card-checklist me-2"></i> Quản lý Lớp học
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#">
                                    <i class="bi bi-bar-chart-line me-2"></i> Thống kê
                                </a>
                            </li>
                        }

                        else if (role == "Faculty")
                        {
                            <li class="nav-item mt-3 text-uppercase text-muted small fw-bold">Giảng viên</li>
                            <li class="nav-item">
                                <a class="nav-link" href="#">
                                    <i class="bi bi-easel me-2"></i> Lớp tôi dạy
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#">
                                    <i class="bi bi-person-lines-fill me-2"></i> Danh sách Sinh viên
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#">
                                    <i class="bi bi-pencil-square me-2"></i> Nhập điểm
                                </a>
                            </li>
                        }

                        else if (role == "Student")
                        {
                            <li class="nav-item mt-3 text-uppercase text-muted small fw-bold">Sinh viên</li>
                            <li class="nav-item">
                                <a class="nav-link" href="#">
                                    <i class="bi bi-person-circle me-2"></i> Hồ sơ cá nhân
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#">
                                    <i class="bi bi-journal-plus me-2"></i> Đăng ký môn học
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#">
                                    <i class="bi bi-journal-bookmark-fill me-2"></i> Môn đã đăng ký
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#">
                                    <i class="bi bi-clipboard-data me-2"></i> Xem điểm
                                </a>
                            </li>
                        }

                        <li class="nav-item mt-3 text-uppercase text-muted small fw-bold">Cá nhân</li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "MyTask")">
                                <i class="bi bi-list-task me-2"></i> My Tasks
                            </a>
                        </li>
                    }
                </ul>

                <div class="mt-4 border-top pt-3">
                    @if (isLogin)
                    {
                        <a class="nav-link text-danger" href="@Url.Action("Index", "Login")">
                            <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                        </a>
                    }
                    else
                    {
                        <a class="nav-link text-success mb-2" href="@Url.Action("Index", "Login")">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Đăng nhập
                        </a>
                        <a class="nav-link text-primary" href="@Url.Action("Index", "Register")">
                            <i class="bi bi-person-plus-fill me-2"></i> Đăng ký
                        </a>
                    }
                </div>
            </div>
        </nav>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 bg-light min-vh-100">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2 text-dark">
                    @if (isLogin)
                    {
                        <span>Xin chào, @Model.Fullname 👋</span>
                    }
                    else
                    {

                        <span>Dashboard</span>
                    }
                </h1>

                @if (ViewBag.isConnectedDatabase)
                {
                    <span class="badge bg-success rounded-pill"><i class="bi bi-database-check"></i> DB Connected</span>
                }
                else
                {
                    <span class="badge bg-danger rounded-pill"><i class="bi bi-database-x"></i> DB Disconnected</span>
                }
            </div>

            @if (isLogin)
            {
                <div class="row mb-4">
                    <div class="col-md-4 mb-3">
                        <div class="card border-0 shadow-sm card-hover h-100 bg-primary text-white">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-uppercase mb-1">Vai trò</h6>
                                        <h3 class="fw-bold">@role</h3>
                                    </div>
                                    <i class="bi bi-shield-lock fs-1 opacity-50"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="card border-0 shadow-sm card-hover h-100 bg-white">
                            <div class="card-body text-dark">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-secondary text-uppercase mb-1">My Tasks</h6>
                                        <h3 class="fw-bold text-primary">05</h3>
                                    </div>
                                    <i class="bi bi-list-check fs-1 text-primary opacity-25"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="card border-0 shadow-sm card-hover h-100 bg-white">
                            <div class="card-body text-dark">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-secondary text-uppercase mb-1">Thông báo</h6>
                                        <h3 class="fw-bold text-danger">02</h3>
                                    </div>
                                    <i class="bi bi-bell-fill fs-1 text-danger opacity-25"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2"></i>Tổng quan hệ thống</h5>
                    </div>
                    <div class="card-body">
                        <p>Chào mừng bạn quay trở lại hệ thống <strong>SIMS</strong>. Hãy sử dụng thanh điều hướng bên trái để truy cập các chức năng dành cho <strong>@role</strong>.</p>
                        <hr>
                        <h6>Công việc cần làm:</h6>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                Kiểm tra danh sách lớp học
                                <span class="badge bg-warning text-dark">Pending</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                Cập nhật hồ sơ cá nhân
                                <span class="badge bg-success">Done</span>
                            </li>
                        </ul>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center mt-5">
                    <i class="bi bi-lock-fill display-1 text-secondary"></i>
                    <h2 class="mt-3">Vui lòng đăng nhập</h2>
                    <p class="text-muted">Bạn cần có tài khoản để truy cập vào các chức năng của hệ thống.</p>
                    <a href="@Url.Action("Index", "Login")" class="btn btn-primary btn-lg mt-2">Đăng nhập ngay</a>
                </div>
            }
        </main>
    </div>
</div>