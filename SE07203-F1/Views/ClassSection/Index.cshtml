@model IEnumerable<SE07203_F1.Models.ClassSection>

@{
    ViewData["Title"] = "Class Sections List";
    // Lấy giá trị tìm kiếm hiện tại từ Controller
    var currentFilter = ViewData["CurrentFilter"];
}

<div class="container py-5">

    <div class="mb-4">
        <h2 class="fw-bold text-dark">
            <i class="bi bi-grid-fill me-2"></i> Class Sections Management
        </h2>
        <p class="text-muted">Manage academic sections, lecturers, courses, rooms, and schedules.</p>
    </div>

    <div class="d-flex justify-content-end mb-3">
        <a href="@Url.Action("Create")" class="btn btn-primary btn-lg px-4 shadow">
            <i class="bi bi-plus-circle me-2"></i> Add Section
        </a>
    </div>

    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group input-group-lg shadow-sm rounded-3">
            <input type="text" name="searchString" class="form-control"
                   value="@currentFilter"
                   placeholder="Search by Code, Course, Lecturer, or Room..." aria-label="Search sections">

            <button class="btn btn-primary" type="submit">
                <i class="bi bi-search"></i> Search
            </button>

            @if (!string.IsNullOrEmpty(currentFilter?.ToString()))
            {
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-lg"></i> Clear
                </a>
            }
        </div>
    </form>
    <div class="card border-0 shadow-lg rounded-3">

        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-dark mb-0">
                <i class="bi bi-list-ul me-2"></i> Active Class Sections
                @if (Model.Any())
                {
                    <span class="badge bg-primary rounded-pill ms-2">@Model.Count()</span>
                }
            </h5>
            @if (!string.IsNullOrEmpty(currentFilter?.ToString()))
            {
                <span class="text-muted small">Showing results for: <strong>"@currentFilter"</strong></span>
            }
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th class="fw-bold">Section Code</th>
                            <th class="fw-bold">Course</th>
                            <th class="fw-bold">Lecturer</th>
                            <th class="fw-bold">Room</th>
                            <th class="fw-bold text-center" style="width: 220px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var cs in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@cs.Code</td>
                                <td>@cs.Course?.Name</td>
                                <td>@cs.Lecturer?.Fullname</td>
                                <td>@cs.Room</td>

                                <td>
                                    <div class="d-flex justify-content-center gap-2">

                                        <a asp-action="Edit" asp-route-id="@cs.Id"
                                           class="btn btn-outline-warning btn-sm px-3"
                                           title="Edit section">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <form asp-action="Delete" asp-route-id="@cs.Id"
                                              method="post"
                                              onsubmit="return confirm('Are you sure you want to delete this class section?');">
                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm px-3"
                                                    title="Delete section">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>

                                    </div>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    No class sections found.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>

        <div class="card-footer bg-light text-end text-muted">
            SIMS © 2025
        </div>

    </div>

</div>