@{
}
@model SE07203_F1.Models.Enrollment

<h1>Enroll Student</h1>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label>Student</label>
        <select asp-for="StudentId" class="form-select">
            @foreach (var s in ViewBag.Students)
            {
                <option value="@s.Id">@s.Fullname</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label>Class Section</label>
        <select asp-for="ClassSectionId" class="form-select">
            @foreach (var cs in ViewBag.ClassSections)
            {
                <option value="@cs.Id">@cs.Code - @cs.Course?.Name</option>
            }
        </select>
    </div>

    <button class="btn btn-success">Enroll</button>
</form>
