@{
}
@model IEnumerable<SE07203_F1.Models.Enrollment>
<h1>Enrollments</h1>

<a href="@Url.Action("Create")" class="btn btn-primary mb-2">Enroll Student</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Student</th>
            <th>Class Section</th>
            <th>Course</th>
            <th>Lecturer</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.Student?.Fullname</td>
                <td>@e.ClassSection?.Code</td>
                <td>@e.ClassSection?.Course?.Name</td>
                <td>@e.ClassSection?.Lecturer?.Fullname</td>
            </tr>
        }
    </tbody>
</table>
